+\[
+  \xymatrix{
+    Y' \ar[d]
+    & P'=P_{(Y')} \ar[l]_{p_{(Y')}} \ar[d]^{u}
+    & X_{(Y')} \ar[l]_{r_{(Y')}} \ar[d]^{v}
+  \\Y
+    & P \ar[l]_{p}
+    & X \ar[l]_{r}
+  }
+\]
+
+Theo \sref{II.4.1.3.2}, ta có
+\[
+  (r_{(Y')})^*(\sh{O}_{P'}(1))=(r_{(Y')})^*(u^*(\sh{O}_P(1)))=v^*(r^*(\sh{O}_P(1)))=v^*(\sh{L})=\sh{L}\otimes_Y\sh{O}_{Y'};
