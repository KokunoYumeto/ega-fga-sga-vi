+\begin{align*}
+  \bb{P}(p^*(\sh{E}))\times_T\bb{P}(p^{\prime *}(\sh{E}'))&=(\bb{P}(\sh{E})\times_Y T)\times_T(T\times_{Y'}\bb{P}(\sh{E}'))\\
+                                               &=\bb{P}(\sh{E})\times_Y(T\times_{Y'}\bb{P}(\sh{E}'))=\bb{P}(\sh{E})\times_S\bb{P}(\sh{E}')
