+\begin{align*}
+\text{a.}\quad &R^if'_*(\mathcal G(n))=0 &&\text{với $i>0$ và $n\geq\nu$},\\
+\text{b.}\quad &R^if'_*(\mathcal K(n))=0 &&\text{với $i>0$ và $n\geq\nu$},\\
+\text{c.}\quad &f'_*(\mathcal K(\nu+k))
+=\mathcal S'_k f'_*(\mathcal K(\nu)) &&\text{với $k\geq0$}.
