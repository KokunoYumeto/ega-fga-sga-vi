+\[
+\label{II.8.12.6.1}
+  \sh{M}^{\square}|\widehat{E}
+  \simto(\sh{M}_X^{\geq})^{\square}|\widehat{E}_X
+\tag{8.12.6.1}
+\]
+\[
+\label{II.8.12.6.2}
+  \widetilde{\sh{M}}|E
+  \simto(\sh{M}_X^{\geq})\supertilde|E_X.
+\tag{8.12.6.2}
+\]
+\end{proposition}
+
+\begin{proof}
